# Base de données — même Postgres que le reste de l'app,
# Mastra y crée ses tables d'état dans le schéma "mastra"
DATABASE_URL=postgresql://mistra:mistra_dev@localhost:5432/mistra

# Transmis au serveur MCP intake (sous-processus stdio)
OCR_ENDPOINT=http://localhost:3020
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Chemin du serveur MCP compilé — utile en Docker uniquement
# (en dev il est trouvé automatiquement : mcp-servers/intake/dist/index.js)
# MCP_INTAKE_PATH=
